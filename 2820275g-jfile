pipeline {
    agent any

    stages {

        stage('2820275g-S1') {
            steps {
                echo "2820275g-S1: Release environment is ready."
            }
        }

        stage('2820275g-S2') {
            steps {
                echo "2820275g-S2: Release Windows checked - Continue the pipeline"
            }
        }

        stage('2820275g-S3') {
            steps {
                echo "2820275g-S3: Web Server is setup and running"
            }
        }

        stage('2820275g-S4A') {
            steps {
                echo "2820275g-S4A:SQL Injection (SQLi) Test - Report Generated"
            }
        }

        stage('2820275g-S4B') {
            steps {
                echo "2820275g-S4A:Cross-Site Scripting (Xss) Test - Report Generated"
            }
        }

        stage('2820275g-S5') {
            steps {
                script {
                    def userOption = input(
                        id: 'Stage5Check',
                        message: '2820275g, after checking security reports, continue the pipeline?',
                        parameters: [
                            choice(
                                choices: ['Proceed', 'Abort'],
                                description: 'Select an option:',
                                name: 'pipestage5option'
                            )
                        ]
                    )

                    if (userOption == 'Proceed') {
                        echo "2820275g-S5: Approve to continue the pipeline."
                    } else {
                        error("Abort Pipeline requested by user.")
                    }
                }

        }

         stage('2820275g-S6') {
            when { expression { currentBuild.resultIsBetterOrEqualTo('SUCCESS') } }
            steps {
                echo "2820275g-S6:Getting ready for next phase."
            }

    }
}
}
